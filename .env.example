# THINKPOINT Environment Variables Template
# Copy this file to .env and insert your real credentials before starting the server.

# OpenRouter AI API Key (Required for AI Mode, Hints, Syntax Assistance, & AI Chat)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Backend Express Server Port (Default: 5000)
PORT=5000

# Optional Supabase Configuration (Fallback local storage active by default)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
